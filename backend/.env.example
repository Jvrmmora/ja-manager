# ---------------------------------------------------------------------------
# Variables de entorno del backend. Copia a .env y rellena los valores.
# El servidor VALIDA estas variables al arrancar (ver src/config/env.ts) y
# aborta con un mensaje claro si falta alguna obligatoria.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4500

# --- Obligatorias ---

# MongoDB
MONGODB_URI=mongodb://localhost:27017/youth-management

# Secreto JWT: mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Cloudinary (https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Opcionales (con valores por defecto) ---

# Algoritmo y expiración del token
TOKEN_ALGORITHM=HS256
TOKEN_EXP=7d

# Orígenes CORS permitidos, separados por coma (obligatorio en producción)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:4173

# Log de todas las queries de Mongoose (ruidoso; solo para depurar)
DB_DEBUG=false

# Nivel de log de winston: error | warn | info | http | debug
LOG_LEVEL=info

# --- Semilla del usuario Super Admin (opcional) ---
# Solo se crea si SEED_ADMIN_ENABLED=true y ambos valores están definidos.
# NUNCA subir credenciales reales al repositorio.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email (Azure Communication Services) ---
# Ver src/services/emailProviders para los proveedores soportados.
